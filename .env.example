# Copy this file to  .env  and paste your real Supabase connection string.
# The .env file is gitignored — it never gets committed.
#
# Use the SESSION POOLER connection string from Supabase
#   (Settings -> Database -> Connection string -> URI, the "Session pooler" one).
# The direct  db.<ref>.supabase.co  URL is too slow for the bigger tables.

SUPABASE_DB_URL=postgresql://postgres.<ref>:<YOUR-PASSWORD>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Optional: only used if SUPABASE_DB_URL is left blank (reads reference from Excel).
# HADRON_WORKBOOK=C:\path\to\As-Is and To-Be Process with sample calculations - Hadron X Donyati 2.xlsx
